{
	"name": "neopostgres_to_adls",
	"properties": {
		"activities": [
			{
				"name": "fetch neopostgres tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT * FROM ctrl.table_config\nwhere is_active=1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTables_DS",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterate all the tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "fetch neopostgres tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('fetch neopostgres tables').output.value",
						"type": "Expression"
					},
					"batchCount": 3,
					"activities": [
						{
							"name": "copy into adls from postgres",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "print tables",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"queryTimeout": "02:00:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "PostgreSqlTable_DS",
									"type": "DatasetReference",
									"parameters": {
										"table_name": {
											"value": "@item().source_table_name",
											"type": "Expression"
										},
										"schema_name": "public"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Parquet_DS",
									"type": "DatasetReference",
									"parameters": {
										"folder_name": {
											"value": "@concat(item().source_schema_name,'/',item().source_table_name,'/',variables('start_date'))",
											"type": "Expression"
										},
										"source_name": {
											"value": "@item().source_schema_name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "print tables",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "start_date",
								"value": {
									"value": "@formatDateTime(utcNow(),'dd-MM-yyyy')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "landing to bronze",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "copy into adls from postgres",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/baddireddy.manikantha@gmail.com/adls connection test",
								"baseParameters": {
									"table_name": {
										"value": "@item().source_table_name",
										"type": "Expression"
									},
									"date_timestamp": {
										"value": "@variables('start_date')",
										"type": "Expression"
									},
									"Load_Type": {
										"value": "@item().load_type",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureDatabricks_LS",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Insert audit table",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "print tables",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_LS",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n'INSERT INTO ctrl.audit_log (adf_run_id, table_id, stage, status, records_written, start_time, end_time, created_timestamp) VALUES (',\n'''', pipeline().RunId, ''', ',\nstring(item().table_id), ', ',\n'''SOURCE_TO_LANDING'', ',\n'''IN-PROGRESS'', ',\n'NULL, ',\n'GETDATE(), ',\n'NULL, ',\n'GETDATE()',\n')'\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "update audit table",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "copy into adls from postgres",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_LS",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n'UPDATE ctrl.audit_log SET status=''COMPLETED'', end_time=GETDATE(), records_written=',\nstring(activity('copy into adls from postgres').output.rowsCopied),\n' WHERE table_id=',\n'''',string(item().table_id),'''',\n'AND status=''IN-PROGRESS'''\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "update audit table failed",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "copy into adls from postgres",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_LS",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n'UPDATE ctrl.audit_log SET ',\n'status=''FAILLED'', ',\n'end_time=GETDATE(), ',\n'comment=''', \nreplace(activity('copy into adls from postgres').error.message,'''',''''''),\n''' ',\n'WHERE table_id=',\nstring(item().table_id)\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"variables": {
			"table": {
				"type": "String"
			},
			"start_date": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Insurance"
		},
		"annotations": []
	}
}